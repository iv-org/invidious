<nav class="feed-menu" aria-label="<%= I18n.translate(locale, "Feed menu") %>">
    <% feed_menu = env.get("preferences").as(Preferences).feed_menu.dup %>
    <% if !env.get?("user") %>
        <% feed_menu.reject! {|item| {"Subscriptions", "Playlists"}.includes? item} %>
    <% end %>
    <% feed_menu.each do |feed| %>
        <a href="/feed/<%= feed.downcase %>" class="feed-menu-item pure-menu-heading" <% if env.request.path == "/feed/#{feed.downcase}" %>aria-current="page"<% end %>>
            <%= I18n.translate(locale, feed) %>
        </a>
    <% end %>
</nav>
